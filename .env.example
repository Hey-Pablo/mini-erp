# Variáveis de ambiente para conexão com Supabase
# Copie este arquivo para .env e preencha com seus valores reais

# URL do projeto Supabase (ex: https://xyz.supabase.co)
VITE_SUPABASE_URL=coloque-sua-url-aqui.supabase.co

# Chave anon do projeto Supabase (encontrada em Settings > API)
VITE_SUPABASE_ANON_KEY=coloque-sua-chave-aqui

# Ou use valores de desenvolvimento (mockados) - NÃO funciona para produção
# VITE_SUPABASE_URL=https://placeholder.supabase.co
# VITE_SUPABASE_ANON_KEY=placeholder-anon-key